#!/bin/sh
# ECM classifies flows from the netfilter hooks. An nft flowtable forwards
# established flows before those hooks, so with software flow offloading on,
# nothing reaches ECM and nothing is accelerated. Keep it off under NSS.
uci -q batch <<-UCI
	set firewall.@defaults[0].flow_offloading='0'
	set firewall.@defaults[0].flow_offloading_hw='0'
	commit firewall
UCI
exit 0
