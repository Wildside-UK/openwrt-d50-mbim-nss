#!/bin/sh /etc/rc.common
# Connection watchdog: ifup wwan, then a rate-limited reboot, when the data
# path is dead. Worker and settings: /usr/sbin/conwatch.sh, /etc/conwatch.conf.

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/conwatch.sh
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
